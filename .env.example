[TEMPLATE]
# KriyaOS environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Truthful status: presence of variables does NOT mean verified external connectivity.

# --- Gemini diagnosis (server-side only; never use NEXT_PUBLIC_ for this key) ---
GOOGLE_AI_API_KEY=
# Optional: override Gemini model (server default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# --- Gemini Live (NOT a verified realtime session bridge in this build) ---
# Uses GOOGLE_AI_API_KEY when present, but a real Gemini Live integration requires
# official supported access + secure realtime audio bridge + mic consent + verification.
# GEMINI_LIVE_ENABLED=false

# --- Nano Banana / official Google image generation-editing (NOT integrated) ---
# Credential-gated foundation only. Requires official supported API/model access and
# server-side implementation verified against official docs. Do not treat placeholders as active.
# NANO_BANANA_ENABLED=false
# NANO_BANANA_MODEL=
# NANO_BANANA_API_KEY=   # only if an official separate credential is required; prefer server-side secret manager

# --- Local prototype persistence / database ---
# Default prototype behavior uses local JSON files under data/ (gitignored).
# SQLite foundation (Node 22 built-in node:sqlite, experimental): set DATABASE_URL and storage backend where supported.
DATABASE_URL="file:./dev.db"
# STORAGE_BACKEND=json|sqlite   (default json; sqlite support is an incremental foundation)
# KRIYAOS_MANUALS_DATA_DIR=
# KRIYAOS_MAINTENANCE_DATA_DIR=
# KRIYAOS_ROBOTICS_DATA_DIR=

# --- OCR for scanned/image-only PDFs (optional, configurable) ---
# Real local OCR (recommended on Windows when Tesseract is installed):
# OCR_ENABLED=true
# OCR_PROVIDER=tesseract-local
# OCR_LANGUAGE=eng                     # requires matching Tesseract language data (e.g. eng.traineddata)
# OCR_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe   # optional if tesseract is on PATH
# OCR_TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata         # optional; depends on Tesseract install
# OCR_MAX_PAGES=50
# OCR_TIMEOUT_MS=180000
# OCR_MAX_PDF_PAGES is enforced in code for safety; split very large manuals.
#
# Alternative HTTP OCR service (local/self-hosted; accepts JSON {pdfBase64,language,maxPages,pageNumbers,preservePageNumbers}):
# OCR_ENABLED=true
# OCR_PROVIDER=http-service
# OCR_SERVICE_URL=http://127.0.0.1:8001/ocr

# --- Offline/local safety watchdog (advisory only; deterministic gate remains authoritative) ---
# WATCHDOG_MODE=off|local-runtime
# WATCHDOG_URL=http://127.0.0.1:11434/api/generate   # local runtime endpoint (e.g., Ollama-compatible). Use localhost to avoid cloud transmission.
# WATCHDOG_MODEL=gemma3:1b
# WATCHDOG_TIMEOUT_MS=8000

# --- Optional Lyria/custom ambient audio hook (user-requested only; NOT a safety feature) ---
# LYRIA_ENABLED=true
# LYRIA_MODE=custom
# LYRIA_CUSTOM_URL=https://your-configured-audio-endpoint.example/generate
# LYRIA_API_KEY=
# NOTE: A configured custom hook is NOT an official Google Lyria integration unless verified against official supported APIs.

# --- Google Agent Skills (NOT integrated; credential-gated foundation only) ---
# Requires official supported interfaces/access/permissions and human approval for consequential operations.
# GOOGLE_AGENT_SKILLS_ENABLED=false

# --- Firebase / Firestore (NOT integrated/verified; credential-gated foundation only) ---
# Requires official Firebase SDK, project config, emulator/prod credentials, secure rules, consent/data minimization.
# FIREBASE_ENABLED=false
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=   # server-side only; use secret manager; never NEXT_PUBLIC_

# --- BigQuery analytics (NOT integrated/verified; credential-gated foundation only) ---
# Analytics must not influence safety decisions. Requires server-side creds and parameterized queries.
# BIGQUERY_ENABLED=false
# GOOGLE_CLOUD_PROJECT=
# BIGQUERY_DATASET=
# BIGQUERY_TABLE=

# --- ERP/CMMS integration foundation ---
# CMMS_ENABLED=true
# CMMS_PROVIDER=demo   # demo = clearly labeled synthetic data; no real ERP contacted
# Future real connector placeholders (not active unless a real connector is implemented):
# CMMS_BASE_URL=
# CMMS_API_KEY=

# --- Optional local authentication (prototype foundation; disabled by default) ---
# AUTH_MODE=none|local
# AUTH_SESSION_SECRET=replace-with-a-long-random-secret-at-least-16-chars
# AUTH_LOCAL_USERNAME=technician
# AUTH_LOCAL_PASSWORD=replace-with-local-dev-password

# Optional runtime
NODE_ENV=development
